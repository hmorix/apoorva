# ─────────────────────────────────────────────────────────────
# MONGODB ATLAS CLOUD DATABASE (Recommended for HMoriX Studio)
# ─────────────────────────────────────────────────────────────
# 1. Create a free cluster at https://www.mongodb.com/atlas
# 2. Add your connection string below:
MONGODB_URI=
MONGODB_DB_NAME=apoorva_kaushal

# ─────────────────────────────────────────────────────────────
# GOOGLE DRIVE CLOUD MEDIA STORAGE (Photos & Videos)
# ─────────────────────────────────────────────────────────────
# 1. Google Cloud Console > Create Service Account & Download Key
# 2. Share a Google Drive folder with the service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# ─────────────────────────────────────────────────────────────
# SANITY.IO CMS CONFIGURATION (Kept for future use)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_WRITE_TOKEN=

