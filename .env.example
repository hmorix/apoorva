# ─────────────────────────────────────────────────────────────
# SANITY.IO CMS CONFIGURATION
# ─────────────────────────────────────────────────────────────
# 1. Sign up / Log in to https://www.sanity.io (Free)
# 2. Create a new project (e.g. "apoorva-kaushal")
# 3. Copy your Project ID and create an API write token in Sanity Settings > API

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────
# OPTIONAL ALTERNATIVE CLOUD MEDIA STORAGE (Cloudinary / ImgBB)
# ─────────────────────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# IMGBB_API_KEY=

